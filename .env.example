QQ_APP_ID=102807599
QQ_CLIENT_SECRET=replace-with-your-app-secret
QQ_GROUP_ALLOWED_USERS=replace-with-comma-separated-group-openids
SUB2API_API_KEY=replace-with-a-dedicated-sub2api-key
# QQ STT baseUrl/model live in platforms.qqbot.extra.stt. Only the secret is
# injected at deploy time; never put the real key in config.yaml or Compose.
QQ_STT_PREFER_BUILTIN=false
QQ_STT_API_KEY=replace-with-the-same-dedicated-sub2api-key
VOICE_TOOLS_OPENAI_KEY=replace-with-the-same-dedicated-sub2api-key
